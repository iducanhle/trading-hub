# Earnings Tracker backend configuration.
# Copy this file to backend/.env (gitignored) and fill it in. Never commit real values.
# Comments sit on their own lines on purpose: some .env parsers keep inline comments as part of the value.

# ---- Data providers ----
FINNHUB_API_KEY=
TWELVEDATA_API_KEY=
# Optional. Leave empty to disable the FMP fallback.
FMP_API_KEY=
# Optional. Free Alpaca paper account (intraday fallback for US symbols); leave empty to disable.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=

# ---- Firebase ----
FIREBASE_PROJECT_ID=
# Path to the service-account JSON key.
# Docker / VM: /run/secrets/firebase-sa.json (mounted by docker-compose).
# Local dev: an absolute path, e.g. to backend/secrets/firebase-sa.json (backend/secrets/ is gitignored).
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-sa.json

# ---- Access control ----
ALLOWED_EMAILS=me@example.com,friend@example.com
CORS_ALLOWED_ORIGINS=https://YOUR_PROJECT.web.app,https://YOUR_PROJECT.firebaseapp.com,http://localhost:4200

# ---- Email (Gmail SMTP with an app password) ----
MAIL_USERNAME=you@gmail.com
MAIL_APP_PASSWORD=
MAIL_FROM_NAME="Earnings Tracker"

# ---- Trading 212 portfolio (optional) ----
# Master key that encrypts the users' Trading 212 API keys: base64 of 32 random bytes, e.g. from
# "openssl rand -base64 32". Empty = the feature is off. Losing or changing it means every user must reconnect.
T212_ENCRYPTION_KEY=
# The server's public IP, shown in Settings so users can restrict their key to it. May stay empty.
T212_SERVER_IP_HINT=

# ---- App ----
APP_BASE_URL=https://YOUR_PROJECT.web.app

# ---- Deployment (Caddy TLS + DuckDNS) ----
DOMAIN=yoursubdomain.duckdns.org
DUCKDNS_SUBDOMAIN=yoursubdomain
DUCKDNS_TOKEN=
TZ=Europe/Prague
