# Monorepo .gitignore. Patterns are unanchored so they apply inside backend/ and frontend/.

# ---- Secrets: never commit ----
.env
.env.*
!.env.example
secrets/
*firebase-sa*.json
*service-account*.json
*serviceAccount*.json
*-firebase-adminsdk-*.json
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*

# ---- Java / Maven (backend) ----
target/
*.class
*.log
hs_err_pid*
replay_pid*

# ---- Node / Angular (frontend) ----
node_modules/
dist/
out-tsc/
coverage/
.angular/
e2e/test-output/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- Firebase CLI ----
.firebase/
firebase-debug.log*
firestore-debug.log*
ui-debug.log*

# ---- IDE / OS ----
.idea/
*.iml
.classpath
.project
.settings/
.factorypath
.DS_Store
Thumbs.db

# ---- Local tooling ----
/tmp/
.claude/settings.local.json
